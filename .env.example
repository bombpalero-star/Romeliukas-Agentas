# Kritimo slenkstis procentais (neigiamas skaičius)
DROP_THRESHOLD=-5

# Telegram pranešimai (neprivaloma)
# 1. Sukurkite botą per @BotFather Telegram'e
# 2. Gaukite chat ID nusiuntę žinutę botui ir patikrinę:
