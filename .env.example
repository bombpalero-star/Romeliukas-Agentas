# Kritimo slenkstis procentais (neigiamas skaičius)
DROP_THRESHOLD=-5

# Telegram pranešimai (neprivaloma)
# 1. Sukurkite botą per @BotFather Telegram'e
# 2. Gaukite chat ID nusiuntę žinutę botui ir patikrinę:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY=false

# ── Political Trades Tracker ──────────────────────────────────────────────────

# Anthropic API key – needed for --ai flag (Claude explains WHY politicians traded)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# How many days back to search for trades (default 30)
DAYS_BACK=30

# Set to "true" to enable AI analysis by default (without --ai flag)
AI_ANALYSIS=false
